// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// This model represents a User in our database
model User {
  id        String   @id // This will be the Clerk User ID
  email     String   @unique
  username  String?  @unique // For public profile URL
  bio       String?  @db.Text
  avatarUrl String?
  headerUrl String?
  
  // Gamertags
  steamId   String?
  psnId     String?
  xboxGamertag String?
  nintendoFriendCode String?
  eaId      String?
  ubisoftId String?
  gogId     String?
  
  // Socials
  twitter   String?
  instagram String?
  discord   String?
  twitch    String?
  youtube   String?

  createdAt DateTime @default(now())
  
  // A user can have many games in their list
  games     Game[]
}

// This model represents a Game saved by a user
model Game {
  id        String   @id @default(cuid()) // Unique ID for this entry
  
  // Data from IGDB
  igdbId    Int      // The ID of the game on IGDB
  name      String
  coverUrl  String?
  summary   String?  @db.Text // Allow long text
  genres    String?  // Comma-separated list of genres
  platforms String?  // Comma-separated list of platforms
  
  // User's tracking data
  status    String   @default("PLANNING") // PLANNING, PLAYING, COMPLETED, DROPPED
  rating    Int?     // 1-100
  review    String?  // Optional text review
  isFavorite Boolean @default(false)
  
  // Relationship to the User
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure a user can't add the same game twice
  @@unique([userId, igdbId])
}
